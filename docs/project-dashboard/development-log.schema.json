{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "project", "entries"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "project": {
      "type": "object",
      "required": ["name", "root", "updatedAt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "updatedAt": { "$ref": "#/definitions/date" }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["changeId", "title", "status", "date", "summary"],
        "properties": {
          "changeId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["proposed", "verified", "archived", "blocked", "superseded", "partial"]
          },
          "date": { "$ref": "#/definitions/date" },
          "type": {
            "type": "string",
            "enum": ["feature", "bugfix", "docs", "tooling", "refactor", "test"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "openspec": {
            "type": "object",
            "properties": {
              "proposal": { "$ref": "#/definitions/nullablePath" },
              "design": { "$ref": "#/definitions/nullablePath" },
              "tasks": { "$ref": "#/definitions/nullablePath" },
              "specDeltas": {
                "type": "array",
                "items": { "$ref": "#/definitions/path" },
                "uniqueItems": true
              },
              "currentSpecs": {
                "type": "array",
                "items": { "$ref": "#/definitions/path" },
                "uniqueItems": true
              },
              "archivePath": {
                "type": "string",
                "pattern": "^openspec/changes/archive/\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*/?$"
              }
            },
            "additionalProperties": false
          },
          "superpowers": {
            "type": "object",
            "properties": {
              "plan": { "$ref": "#/definitions/nullablePath" }
            },
            "additionalProperties": false
          },
          "implementation": {
            "type": "object",
            "properties": {
              "sourceFiles": {
                "type": "array",
                "items": { "$ref": "#/definitions/path" },
                "uniqueItems": true
              },
              "testFiles": {
                "type": "array",
                "items": { "$ref": "#/definitions/path" },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["command", "result"],
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "result": {
                  "type": "string",
                  "enum": ["passed", "failed", "skipped", "blocked", "not-run"]
                },
                "note": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "closeout": { "$ref": "#/definitions/nullablePath" },
          "next": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "nonGoals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "archived" } } },
            "then": {
              "required": ["openspec", "superpowers", "implementation", "verification", "closeout"],
              "properties": {
                "openspec": {
                  "required": ["proposal", "tasks", "specDeltas", "currentSpecs", "archivePath"]
                },
                "verification": { "minItems": 1 },
                "closeout": { "$ref": "#/definitions/path" }
              }
            }
          },
          {
            "if": { "properties": { "status": { "const": "verified" } } },
            "then": {
              "required": ["implementation", "verification"],
              "properties": {
                "verification": { "minItems": 1 }
              }
            }
          },
          {
            "if": { "properties": { "status": { "const": "proposed" } } },
            "then": {
              "required": ["openspec"],
              "properties": {
                "openspec": {
                  "required": ["proposal", "tasks", "specDeltas"]
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\0]+$"
    },
    "nullablePath": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "^[^\\0]+$"
    }
  }
}
