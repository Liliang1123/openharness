# OpenHarness local environment example.
# Copy to .env for local development. Do not commit real .env files.

# Agent runtime HTTP server
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
JAVA_BACKEND_URL=http://localhost:8080
OPENHARNESS_SERVICE_TOKEN=dev-service-token

# History and memory storage
HISTORY_STORE=file
HISTORY_DATA_DIR=agent-runtime/data/sessions
MEMORY_DATA_DIR=agent-runtime/data/memory

# Runtime behavior
COMPRESSION_AUTO=true
COMPRESSION_THRESHOLD=8000
KEEP_RECENT_MESSAGES=6
MODEL_CONTEXT_BUDGET_TOKENS=8000
AGENT_STEP_BUDGET=25
CACHE_STRATEGY=double
OPENHARNESS_PROMPT_REF=openharness-default@v1
OPENHARNESS_SKILLS_ENABLED=false
MCP_REQUIRE_APPROVAL=false

# Timeouts, milliseconds
EXECUTION_TIMEOUT_MS=1800000
APPROVAL_TIMEOUT_MS=3600000

# Backend tool execution workspace
TOOL_WORKSPACE_DIR=/tmp/openharness-tool-workspace

# Frontend dev settings
VITE_AGENT_RUNTIME_URL=http://localhost:3001
VITE_DEV_USER_ID=user-001
VITE_DEV_TENANT_ID=tenant-001

# Integration tests, optional external service URLs
BACKEND_URL=http://127.0.0.1:18081
AGENT_RUNTIME_URL=http://127.0.0.1:13001
