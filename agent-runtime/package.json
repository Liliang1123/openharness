    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
